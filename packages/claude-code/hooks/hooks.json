{
  "description": "Zotero Reading Bridge: attach the current Zotero selection to each prompt (read-only)",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:zotero-reading-bridge:zotero",
            "tool": "capture_prompt_context",
            "input": {
              "client": "claude-code",
              "session_id": "${session_id}",
              "prompt_id": "${prompt_id}"
            },
            "timeout": 5,
            "statusMessage": "Reading Zotero context"
          }
        ]
      }
    ]
  }
}
