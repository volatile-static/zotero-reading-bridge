# Zotero AI Bridge：Codex 手动配置示例（不安装插件时使用）
#
# 用法：把下面两段追加到 ~/.codex/config.toml（Windows：%USERPROFILE%\.codex\config.toml）。
# - 与 Codex 插件二选一：以后改用插件时，先从 config.toml 删除这两段。两者同时存在时，这里的同名条目
#   优先级更高，插件 .mcp.json 中的设置（例如端口）会被忽略，这里的 Hook 段还会让每轮调用两次。
# - 服务器键名必须是 zotero_bridge（与插件相同）。
# - 不要改用 [mcp_servers.zotero]：很多人已经用这个名字注册了别的 Zotero MCP 服务器，
#   会与本项目混淆。
# - 端口以 Zotero 设置中「Zotero AI Bridge」页面显示的实际地址为准（默认 23119）。
# - 只使用 127.0.0.1，不要写 localhost（可能先解析到 ::1，而 Zotero 只监听 IPv4 回环地址）。
# - 不要设置 default_tools_approval_mode：本示例不放宽 Codex 的工具审批策略。

[mcp_servers.zotero_bridge]
url = "http://127.0.0.1:23119/bridge/mcp"
startup_timeout_sec = 10
tool_timeout_sec = 30

# 可选：每轮对话前自动附加当前 Zotero 选择（与插件内置 Hook 等价）。
# Hook 首次出现或内容改动后都必须在 Codex 中信任一次（CLI：/hooks；桌面版：Review hooks 或 Settings > Hooks）。
# 已经安装了 Codex 插件时不要使用本文件（二选一）；至少要删除这一段，否则每轮会运行两次。
# 多人共用的电脑上不要添加这一段：Zotero 未运行时，占用 23119 端口的其他程序能经 Hook 向每条消息注入文字。
# 同一配置层不要同时使用 ~/.codex/hooks.json 和这里的 [hooks]。

[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "mcp_tool"
server = "zotero_bridge"
tool = "capture_prompt_context"
timeout = 5
statusMessage = "Reading Zotero context"

[hooks.UserPromptSubmit.hooks.input]
client = "codex"
session_id = "${session_id}"
turn_id = "${turn_id}"
