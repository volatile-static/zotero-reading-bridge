{
  "name": "zotero-reading-bridge",
  "version": "0.2.1",
  "private": true,
  "description": "Zotero Reading Bridge: read-only Zotero MCP endpoint plus Codex and Claude Desktop plugins",
  "license": "GPL-3.0-or-later",
  "author": "volatile-static",
  "keywords": [
    "zotero",
    "research",
    "citations",
    "pdf",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsx scripts/typecheck.ts",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\" \"tests/protocol/**/*.test.ts\" \"tests/zotero/*.test.ts\"",
    "build": "tsx scripts/build.ts",
    "verify": "tsx scripts/verify-package.ts",
    "test:zotero": "tsx tests/zotero/run.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/archiver": "8.0.0",
    "@types/node": "24.19.2",
    "@types/yauzl": "3.4.0",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yauzl": "3.4.0",
    "zotero-types": "4.1.3"
  }
}
